name: Unzip KENO
on:
  workflow_dispatch:
permissions:
  contents: write
jobs:
  unzip:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Raspakuj i commituj
        run: |
          unzip -o KENO_V2_Project.zip -x ".github/*"
          rm KENO_V2_Project.zip
          chmod +x gradlew
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add -A
          git commit -m "KENO V2 raspakovan"
          git push
